{
	"name": "icanboogie/bind-message-bus",
	"type": "library",
	"description": "Binds icanboogie/message-bus to ICanBoogie",
	"keywords": [
		"message",
		"bus"
	],
	"homepage": "https://icanboogie.org/",
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Olivier Laviale",
			"email": "olivier.laviale@gmail.com",
			"homepage": "https://olvlvl.com/",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/ICanBoogie/bind-message-bus/issues",
		"source": "https://github.com/ICanBoogie/bind-message-bus"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"icanboogie/autoconfig": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"prefer-dist": true,
	"require": {
		"php": ">=8.4",
		"icanboogie/icanboogie": "^7.0",
		"icanboogie/message-bus": "^7.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^13.4"
	},
	"autoload-dev": {
		"psr-4": {
			"Test\\ICanBoogie\\Binding\\MessageBus\\": "tests/lib"
		}
	},
	"extra": {
		"icanboogie": {
			"config-path": "config"
		}
	}
}
